{
  "name": "doors-of-durin-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Demo web frontend for the Token ACL gate, driven against a local surfnet.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "surfnet": "surfpool start --offline --no-tui --no-deploy -y --airdrop-amount 0",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@solana/kit": "^2",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
